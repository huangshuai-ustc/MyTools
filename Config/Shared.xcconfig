PRODUCT_BUNDLE_IDENTIFIER = com.fjwyz.PersonalToolBox
APP_DISPLAY_NAME = 方寸
DEVELOPMENT_TEAM =

// Comment out one MYTOOLS_ENABLE_* line to omit only that feature module.
MYTOOLS_ENABLE_FINANCE = MYTOOLS_FEATURE_FINANCE
MYTOOLS_ENABLE_STOCKS = MYTOOLS_FEATURE_STOCKS
MYTOOLS_ENABLE_CURRENCY_EXCHANGE = MYTOOLS_FEATURE_CURRENCY_EXCHANGE
MYTOOLS_ENABLE_HEALTH = MYTOOLS_FEATURE_HEALTH
MYTOOLS_ENABLE_FOOD_MAP = MYTOOLS_FEATURE_FOOD_MAP
MYTOOLS_ENABLE_SECRETS = MYTOOLS_FEATURE_SECRETS
MYTOOLS_ENABLE_DOCUMENTS = MYTOOLS_FEATURE_DOCUMENTS
MYTOOLS_ENABLE_BILLS = MYTOOLS_FEATURE_BILLS
MYTOOLS_ENABLE_SPORTS_LOTTERY = MYTOOLS_FEATURE_SPORTS_LOTTERY

// Aggregated automatically. Do not edit this line when enabling or disabling modules.
MYTOOLS_COMPILED_FEATURES = $(MYTOOLS_ENABLE_FINANCE) $(MYTOOLS_ENABLE_STOCKS) $(MYTOOLS_ENABLE_CURRENCY_EXCHANGE) $(MYTOOLS_ENABLE_HEALTH) $(MYTOOLS_ENABLE_FOOD_MAP) $(MYTOOLS_ENABLE_SECRETS) $(MYTOOLS_ENABLE_DOCUMENTS) $(MYTOOLS_ENABLE_BILLS) $(MYTOOLS_ENABLE_SPORTS_LOTTERY)

// Uncomment a MYTOOLS_HIDE_* line to compile that module but keep it hidden on a
// fresh install. Explicit local settings and CloudKit preferences take priority.
// MYTOOLS_HIDE_FINANCE = MYTOOLS_DEFAULT_HIDDEN_FINANCE
// MYTOOLS_HIDE_STOCKS = MYTOOLS_DEFAULT_HIDDEN_STOCKS
// MYTOOLS_HIDE_CURRENCY_EXCHANGE = MYTOOLS_DEFAULT_HIDDEN_CURRENCY_EXCHANGE
// MYTOOLS_HIDE_HEALTH = MYTOOLS_DEFAULT_HIDDEN_HEALTH
// MYTOOLS_HIDE_FOOD_MAP = MYTOOLS_DEFAULT_HIDDEN_FOOD_MAP
// MYTOOLS_HIDE_SECRETS = MYTOOLS_DEFAULT_HIDDEN_SECRETS
// MYTOOLS_HIDE_DOCUMENTS = MYTOOLS_DEFAULT_HIDDEN_DOCUMENTS
// MYTOOLS_HIDE_BILLS = MYTOOLS_DEFAULT_HIDDEN_BILLS
// MYTOOLS_HIDE_SPORTS_LOTTERY = MYTOOLS_DEFAULT_HIDDEN_SPORTS_LOTTERY

// Aggregated automatically. Do not edit this line when setting default-hidden modules.
MYTOOLS_DEFAULT_HIDDEN_FEATURES = $(MYTOOLS_HIDE_FINANCE) $(MYTOOLS_HIDE_STOCKS) $(MYTOOLS_HIDE_CURRENCY_EXCHANGE) $(MYTOOLS_HIDE_HEALTH) $(MYTOOLS_HIDE_FOOD_MAP) $(MYTOOLS_HIDE_SECRETS) $(MYTOOLS_HIDE_DOCUMENTS) $(MYTOOLS_HIDE_BILLS) $(MYTOOLS_HIDE_SPORTS_LOTTERY)

#include? "Signing.local.xcconfig"
